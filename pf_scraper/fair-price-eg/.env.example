ENV=dev
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=valorai
JWT_AUDIENCE=valorai-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=600
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id

# Firebase Web SDK values consumed by the Docker-built React/Vite frontend.
# These values are build-time inputs for Vite and must be present before `docker compose build frontend`.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=


DATABASE_URL=postgresql+psycopg://fairprice:fairprice@localhost:5432/fairprice
DB_STARTUP_RETRIES=30
DB_STARTUP_RETRY_SECONDS=1

CORS_ORIGINS=http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

API_REQUEST_TIMEOUT_SECONDS=20
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
SLOW_QUERY_MS=250
SLOW_REQUEST_MS=1500
API_LATENCY_SLO_MS=1200
VALUATION_LATENCY_SLO_MS=1500

ADDRESS_RESOLVER_VERSION=3A.1b.1
ADDRESS_CACHE_EXTERNAL_TTL_DAYS=30
AREA_AMBIGUITY_DISTANCE_M=25


