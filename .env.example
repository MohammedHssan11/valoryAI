# ValoryAI Master Environment Configurations Template
# Copy templates to their respective local directories:
# 1. /backend/.env
# 2. /frontend/web/.env

# ==========================================
# 1. BACKEND SERVICE SETTINGS (/backend/.env)
# ==========================================

ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL + PostGIS Connection URL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/databasename

# JWT Bearer Token Signatures
JWT_SECRET=valorai_super_secret_key_2026_production_ready_12345
JWT_ISSUER=valorai
JWT_AUDIENCE=valorai-api

# Firebase Project Configs for JWT verification
FIREBASE_PROJECT_ID=valorai-e25b8

# CORS Allowed Web Origins (semi-colon separated)
CORS_ORIGINS=http://localhost:3000;http://localhost:5173;http://127.0.0.1:3000;http://127.0.0.1:5173


# ==================================================
# 2. FRONTEND WEB SERVICE SETTINGS (/frontend/web/.env)
# ==================================================

VITE_APP_ENV=dev
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=20000

# Firebase Web App Keys (Public credentials)
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
